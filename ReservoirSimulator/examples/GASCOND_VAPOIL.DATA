-- =====================================================================
-- Gas-condensate reservoir with vaporised oil (VAPOIL, PVTG) and
-- dissolved gas (DISGAS, PVTO).  The reservoir gas starts at its dew
-- point; depletion drops condensate around the producer, then dry-gas
-- cycling re-vaporises part of it.   FIELD units, 12 x 12 x 3 grid.
-- =====================================================================
RUNSPEC
TITLE
   Gas condensate depletion and gas cycling (VAPOIL)

DIMENS
   12 12 3 /

OIL
WATER
GAS
DISGAS
VAPOIL

FIELD

TABDIMS
 1 1 20 20 /

WELLDIMS
 2 3 1 2 /

START
   1 'JAN' 2025 /

GRID

DXV
   12*800 /
DYV
   12*800 /
DZV
   30 30 40 /
TOPS
   144*8000 /
PORO
   432*0.20 /
PERMX
   144*50 144*30 144*80 /
PERMY
   144*50 144*30 144*80 /
PERMZ
   144*5 144*3 144*8 /

PROPS

PVTW
   4500  1.02  3.0E-6  0.35  0 /

ROCK
   4500  4.0E-6 /

DENSITY
-- oil   water  gas  (lb/ft3)
   46.0  63.0   0.065 /

-- Wet gas: Pg  Rv_sat  Bg  mu_g   followed by the undersaturated row at Rv = 0
--          psia stb/Mscf rb/Mscf cP
PVTG
  500   0.0100  6.00  0.0135
        0.0     5.95  0.0133 /
 1000   0.0200  2.90  0.0150
        0.0     2.86  0.0147 /
 1500   0.0300  1.90  0.0168
        0.0     1.87  0.0164 /
 2000   0.0420  1.42  0.0188
        0.0     1.39  0.0183 /
 2500   0.0560  1.15  0.0210
        0.0     1.12  0.0204 /
 3000   0.0720  0.98  0.0233
        0.0     0.955 0.0226 /
 3500   0.0930  0.87  0.0258
        0.0     0.845 0.0249 /
 4000   0.1200  0.79  0.0285
        0.0     0.765 0.0274 /
 4500   0.1500  0.73  0.0313
        0.0     0.705 0.0300 /
 5500   0.2100  0.66  0.0370
        0.0     0.635 0.0350 /
/

-- Condensate liquid: Rs  Pbub  Bo  mu_o
PVTO
 0.20   500  1.18  0.62 /
 0.45  1000  1.29  0.52 /
 0.75  1500  1.42  0.44 /
 1.05  2000  1.56  0.38 /
 1.35  2500  1.70  0.33 /
 1.70  3000  1.86  0.29 /
 2.10  3500  2.04  0.26 /
 2.50  4000  2.22  0.23
       5500  2.15  0.25 /
/

SWOF
-- Sw    krw    krow   Pcow
   0.20  0.000  1.000  0
   0.30  0.010  0.640  0
   0.40  0.040  0.360  0
   0.50  0.090  0.160  0
   0.60  0.160  0.040  0
   0.70  0.250  0.000  0
   1.00  1.000  0.000  0 /

SGOF
-- Sg    krg    krog   Pcgo     (critical condensate saturation ~0.2)
   0.00  0.000  1.000  0
   0.10  0.020  0.600  0
   0.20  0.070  0.300  0
   0.30  0.140  0.120  0
   0.40  0.230  0.030  0
   0.50  0.340  0.000  0
   0.60  0.470  0.000  0
   0.80  0.800  0.000  0 /

SOLUTION

EQUIL
-- datum pres  WOC   Pcow GOC
   8050  4500  9500  0    9000  0 /

-- reservoir gas at its dew point (Rv_sat(4000 psia) = 0.12 stb/Mscf)
RVVD
  7000 0.12
  9500 0.12 /

SUMMARY
FOPR
FGPR
FGIR
FPR
FOIP
FGOR

SCHEDULE

WELSPECS
   'PROD' 'G' 10 10 8000 'GAS' /
   'INJ'  'G'  3  3 8000 'GAS' /
/

COMPDAT
   'PROD' 2* 1 3 'OPEN' 2* 0.5 /
   'INJ'  2* 1 3 'OPEN' 2* 0.5 /
/

-- ---- 3 years of depletion
WCONPROD
   'PROD' 'OPEN' 'GRAT' 2* 40000 2* 1200 /
/
WCONINJE
   'INJ' 'GAS' 'SHUT' 'RATE' 0 /
/
TSTEP
   6*182.6 /

-- ---- 3 years of dry-gas cycling
WCONINJE
   'INJ' 'GAS' 'OPEN' 'RATE' 30000 1* 6000 /
/
TSTEP
   6*182.6 /

END
