8300 1.270
8450 1.270 /

SUMMARY
FOPR
FOPT
FGPR
FGIR
FGSR
FGCR
FPR
GOPR
/
GGPR
/
GGIR
/
GPR
/
WOPR
/
WGOR
/
WBHP
/
WTHP
/
WSTAT
/

SCHEDULE

GRUPTREE
   'PLAT-A' 'FIELD' /
   'PLAT-B' 'FIELD' /
/

WELSPECS
   'PA1' 'PLAT-A'  3  3 8400 'OIL' /
   'PA2' 'PLAT-A'  3 13 8400 'OIL' /
   'PA3' 'PLAT-A'  8  8 8400 'OIL' /
   'PA4' 'PLAT-A'  8  3 8400 'OIL' /
   'GI'  'PLAT-A'  1  1 8335 'GAS' /
   'PB1' 'PLAT-B' 13  3 8400 'OIL' /
   'PB2' 'PLAT-B' 13 13 8400 'OIL' /
   'PB3' 'PLAT-B' 13  8 8400 'OIL' /
   'PB4' 'PLAT-B'  8 13 8400 'OIL' /
/

COMPDAT
   'PA*' 2* 2 3 'OPEN' 2* 0.5 /
   'PB*' 2* 2 3 'OPEN' 2* 0.5 /
   'GI'  2* 1 1 'OPEN' 2* 0.5 /
/

-- well tubing (table 1, to the well datum) and the PLAT-A pipeline (table 2)
VFPPROD
  1 8400 'OIL' 'WCT' 'GOR' 'THP' '' 'FIELD' 'BHP' /
  500 5000 20000 /
  100 500 1500 /
  0 0.5 /
  1 5 /
  0 /
  1 1 1 1  2700 2740 2900 /
  1 1 2 1  1700 1760 2000 /
  1 2 1 1  3000 3040 3200 /
  1 2 2 1  2000 2060 2300 /
  2 1 1 1  3100 3140 3300 /
  2 1 2 1  2100 2160 2400 /
  2 2 1 1  3400 3440 3600 /
  2 2 2 1  2400 2460 2700 /
  3 1 1 1  4100 4140 4300 /
  3 1 2 1  3100 3160 3400 /
  3 2 1 1  4400 4440 4600 /
  3 2 2 1  3400 3460 3700 /
/

VFPPROD
  2 0 'OIL' 'WCT' 'GOR' 'THP' '' 'FIELD' 'BHP' /
  500 5000 20000 /
  100 500 1500 /
  0 /
  1 5 /
  0 /
  1 1 1 1  103 130 220 /
  1 1 2 1  105 150 300 /
  2 1 1 1  503 530 620 /
  2 1 2 1  505 550 700 /
  3 1 1 1  1503 1530 1620 /
  3 1 2 1  1505 1550 1700 /
/

-- PLAT-A wells: group control, BHP 1000 psia, THP 100 psia with tubing table 1
WCONPROD
   'PA1' 'OPEN' 'GRUP' 5* 1000 100 1 /
   'PA2' 'OPEN' 'GRUP' 5* 1000 100 1 /
   'PA3' 'OPEN' 'GRUP' 5* 1000 100 1 /
   'PA4' 'SHUT' 'ORAT' 6000 4* 1000 100 1 /
   'PB*' 'OPEN' 'ORAT' 5000 4* 1000 /
/

WCONINJE
   'GI' 'GAS' 'OPEN' 'RATE' 60000 1* 6000 /
/

-- field oil target shared by guide rates (potentials); PLAT-A gas limit acts as a target too
GCONPROD
   'FIELD'  'ORAT' 18000 3* 'RATE' /
   'PLAT-A' 'FLD'  1* 1* 40000 1* 'RATE' /
/

-- PLAT-B: wells opened in order of priority up to 12000 stb/d
GCONPRI
   'PLAT-B' 12000 'PRI' /
/
WELPRI
   'PB2' 3 /
   'PB1' 2 /
/
-- other wells: priority = oil potential, re-evaluated at most once a year
PRIORITY
   365 0 1 0 0 1 0 0 0 /

-- drilling queue: opened when the field cannot meet its oil target
QDRILL
   'PB3' 'PB4' /

-- economics: PLAT-A shuts its worst well above a GOR of 6 Mscf/stb;
-- PA3 is replaced by PA4 when its oil rate falls below 800 stb/d
GECON
   'PLAT-A' 1* 1* 1* 6 1* 'WELL' 'NO' /
/
WECON
   'PA3' 800 4* 'WELL' 'NO' 'PA4' /
/
WTEST
   'PA*' 365 'G' 2 /
/

-- sales gas: fuel 2 MMscf/d, sales target 10 MMscf/d (maximum 30)
GCONSUMP
   'PLAT-A' 2000 /
/
GCONSALE
   'FIELD' 10000 30000 1* 'RATE' /
/

-- production network: 200 psia at the terminal node, PLAT-A through pipeline table 2
GRUPNET
   'FIELD'  200 /
   'PLAT-A' 1*  2 /
/

TSTEP
   1 9 20 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30
   12*91.25 /

END
