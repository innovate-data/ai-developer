<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Only the launch screen lives here. Every other Info.plist key is generated by Xcode from
  the target's build settings (GENERATE_INFOPLIST_FILE), and merged with this file.

  The launch screen is the app's own background colour with the logo centred on it, in
  light and dark. It matches the first frame of the app exactly, and RootView in
  CubeClubhouseApp.swift keeps the same picture up until the page has loaded, so the
  child sees one calm hand-over rather than a flash.
-->
<plist version="1.0">
<dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
</dict>
</plist>
