<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Cube Clubhouse collects nothing and tracks nobody. It says so here in the form App
	  Review reads, and it matches the Privacy page inside the app in substance.

	  The one API Apple asks a reason for is UserDefaults: UpdateChecker keeps whether the
	  update check is on, when it last ran, and a version someone said "Not Now" to. That
	  is only ever read by this app (reason CA92.1). The update check itself asks Apple's
	  App Store whether a newer version exists; nothing about the person is sent, so there
	  is no collected data type to declare and no tracking domain.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
